---
import { appLink } from '../domain/app-link';
import Site from '../layouts/site.astro';

const destination = appLink(import.meta.env.DEV, import.meta.env.PUBLIC_APP_URL);
const principles = [
    {
        number: '01',
        title: 'Make room for the small things.',
        description:
            'A habit does not need to change everything. Start with something small enough to return to, even on an ordinary day.',
        detail: 'Habits, at your pace',
    },
    {
        number: '02',
        title: 'Notice what moves you.',
        description:
            'Leave a few words about your day. Make space for the patterns, questions and moments you might otherwise pass by.',
        detail: 'A place to reflect',
    },
    {
        number: '03',
        title: 'Keep your own direction.',
        description:
            'Bring your attention back to what matters to you. Growth can be thoughtful, personal and a little less hurried.',
        detail: 'Room to find your way',
    },
];
---

<Site>
    <header class="site-header">
        <a class="brand" href="/" aria-label="cap01 home">
            <span class="brand-mark" aria-hidden="true">
                ✳
            </span>
            cap01
        </a>
        <nav aria-label="Main">
            <a href="#approach">Our approach</a>
            <a href="#preview">
                The preview <span aria-hidden="true">↗</span>
            </a>
        </nav>
    </header>
    <main id="main">
        <section class="hero" aria-labelledby="hero-title">
            <p class="eyebrow">
                <span class="status-dot" aria-hidden="true"></span>A companion, in the making
            </p>
            <h1 id="hero-title">A little more intentional.</h1>
            <p class="hero-description">
                A little structure for your habits.
                <br />A little room for yourself.
            </p>
            <p class="hero-context">
                cap01 is an AI habit and growth coach we're building for the everyday. Small steps,
                thoughtful reflection, and a direction of your own.
            </p>
            <a class="button" href="#approach">
                Meet cap01 <span aria-hidden="true">↓</span>
            </a>
            <div class="quiet-orbit" aria-hidden="true">
                <div></div>
                <span></span>
            </div>
        </section>
        <section class="approach" id="approach" aria-labelledby="approach-title">
            <div class="section-heading">
                <p class="eyebrow">A quieter kind of progress</p>
                <h2 id="approach-title">Your life. Your pace.</h2>
            </div>
            <div class="principles">
                {principles.map((principle) => (
                    <article>
                        <span class="index">{principle.number}</span>
                        <div>
                            <p class="detail">{principle.detail}</p>
                            <h3>{principle.title}</h3>
                            <p>{principle.description}</p>
                        </div>
                    </article>
                ))}
            </div>
        </section>
        <section class="preview" id="preview" aria-labelledby="preview-title">
            <div>
                <p class="eyebrow">One small beginning</p>
                <h2 id="preview-title">Still taking shape.</h2>
                <p>
                    The first web preview makes space for habits and a journal, saved in your
                    browser. AI coaching and the mobile companion are still ahead.
                </p>
            </div>
            <div class="preview-action">
                {destination ? (
                    <a class="button" href={destination}>
                        {import.meta.env.DEV ? 'Explore the local preview' : 'Explore the web app'}
                        <span aria-hidden="true">↗</span>
                    </a>
                ) : (
                    <p class="availability">
                        <span class="status-dot" aria-hidden="true"></span>
                        Public preview coming later
                    </p>
                )}
                <p class="small">A small space for habits and reflection.</p>
            </div>
        </section>
    </main>
    <footer>
        <a class="brand" href="/">
            cap01
        </a>
        <p>A little more intentional.</p>
        <a href="#main">
            Back to the beginning <span aria-hidden="true">↑</span>
        </a>
    </footer>
</Site>
